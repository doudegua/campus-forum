# ===========================================================================
# .env.example —— 环境变量模板
#
# 用法：复制成 .env，把空着的填上。.env 已被 .gitignore 挡住，**不会进仓库**。
#
#     cp .env.example .env
#
# 为什么要有这个机制：
#   application.yaml 是公开的，所以里面只能是 ${VAR:默认值} 的形式。
#   真实密钥写在 .env 里，由 docker compose 注入容器 —— 这样
#   "配置文件进仓库"和"密钥不进仓库"两件事才能同时成立。
#
# 什么时候必须填：
#   本地开发  基本不用填。只有"发邮箱验证码"需要 MAIL_PASSWORD。
#   Docker 部署  至少要改 DB_PASSWORD、JWT_KEY、MINIO_ROOT_PASSWORD、RABBITMQ_PASSWORD。
# ===========================================================================

# --- 数据库 ---------------------------------------------------------------
# docker compose 内部的 MySQL 密码。compose 会用它初始化 mysql 容器，
# 后端也用它连库 —— 两处必须是同一个值。
DB_PASSWORD=
# 本地开发时默认连 localhost:3306/test，所以下面这些通常不用改。
# docker compose 会把这几个覆盖成服务名（mysql / minio / rabbitmq / redis）。
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=test
# DB_USERNAME=root

# --- JWT ------------------------------------------------------------------
# 签发登录 token 的密钥。**部署到公网必须改掉**，默认的 666666 等于没设：
# 拿到它的人可以伪造任意用户的 token，不需要知道任何人的密码。
# 生成一个随机串：
#     openssl rand -base64 48
JWT_KEY=

# --- 邮箱（发注册/重置密码的验证码）---------------------------------------
# 163 邮箱的 SMTP 授权码，不是登录密码。
# 去 163 网页版：设置 → POP3/SMTP/IMAP → 开启服务 → 获取授权码。
# 不填不影响应用启动，只是"发验证码"这个功能会失败。
MAIL_PASSWORD=
# MAIL_USERNAME=emailverify114514@163.com

# --- MinIO（存图片）-------------------------------------------------------
# ⚠️ compose 里只需要这两个名字。容器用它们初始化 MinIO，
#    后端也用同一对去连 —— 所以**只有一处要改**，不会出现两边不一致。
#    改完记得：已经跑过一次的 MinIO 数据卷里保存的是旧账号，
#    换账号要么 `docker compose down -v` 重来，要么进容器改。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 后端读的 MINIO_ACCESS_KEY / MINIO_SECRET_KEY 由 compose 自动从上面两个
# 转发过去，**不要在这里单独设** —— 设了两边就可能不一致，
# 症状是"登录没问题但头像和配图全是破图"。
MINIO_BUCKET=study

# --- RabbitMQ -------------------------------------------------------------
# guest/guest 只能从本机访问，容器之间走内部网络所以能用。
# 生产环境建议改成别的。注意 RabbitMQ 对 guest 账号有"仅限 localhost"的限制，
# 在 compose 的内部网络里会被当成非本机 —— 如果收不到验证码邮件，
# 先怀疑这里，换个非 guest 账号试试。
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Redis ----------------------------------------------------------------
# 项目里 Redis 用来存 JWT 黑名单（登出时把 token 的 jti 拉黑）。没有密码。
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- 和风天气 -------------------------------------------------------------
# api-host 和这几个 ID 不是密钥，真正的凭据是
# my-project-backend/src/main/resources/qweather/ed25519-private.pem
# 那把私钥 —— 它被 .gitignore 挡着，绝不入库。
# 没有这把私钥时，天气接口会失败，但应用照样启动、其它功能不受影响。
# QWEATHER_API_HOST=ma487v6uam.re.qweatherapi.com
# QWEATHER_KID=T95D4A378G
# QWEATHER_DEVELOPER_ID=Q15620077C
# QWEATHER_PROG_ID=2NKPDF6EQY
